{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/rg/v1/contract.schema.json",
  "title": "RG proof pipeline immutable payload",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rational": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)(/[1-9][0-9]*)?$"
    },
    "interval": {
      "type": "object",
      "required": [
        "lo",
        "hi"
      ],
      "properties": {
        "lo": {
          "$ref": "#/$defs/rational"
        },
        "hi": {
          "$ref": "#/$defs/rational"
        }
      },
      "additionalProperties": false
    },
    "constant": {
      "type": "object",
      "required": [
        "name",
        "value",
        "scope",
        "derivation",
        "freeVariables"
      ],
      "properties": {
        "name": {
          "enum": [
            "C",
            "m",
            "g_bound",
            "epsilon"
          ]
        },
        "value": {
          "$ref": "#/$defs/interval"
        },
        "scope": {
          "const": "uniform_all_a_L"
        },
        "derivation": {
          "$ref": "#/$defs/digest"
        },
        "freeVariables": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "not": {
            "contains": {
              "enum": [
                "a",
                "L",
                "a_k",
                "volume",
                "box_length"
              ]
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": [
        "kind",
        "theory",
        "version",
        "k",
        "a",
        "g",
        "boxLength",
        "volumeSites",
        "dimension",
        "cutoffs",
        "gaugeGroup",
        "boundary"
      ],
      "properties": {
        "kind": {
          "const": "ScaleState"
        },
        "theory": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "const": "rg-contract/1"
        },
        "k": {
          "type": "integer",
          "minimum": 0
        },
        "a": {
          "$ref": "#/$defs/rational"
        },
        "g": {
          "$ref": "#/$defs/interval"
        },
        "boxLength": {
          "type": "integer",
          "minimum": 1
        },
        "volumeSites": {
          "type": "integer",
          "minimum": 1
        },
        "dimension": {
          "const": 4
        },
        "cutoffs": {
          "type": "object",
          "required": [
            "smallField",
            "largeField"
          ],
          "properties": {
            "smallField": {
              "$ref": "#/$defs/rational"
            },
            "largeField": {
              "$ref": "#/$defs/rational"
            }
          },
          "additionalProperties": false
        },
        "gaugeGroup": {
          "const": "SU(2)"
        },
        "boundary": {
          "const": "periodic"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "kind",
        "theory",
        "version",
        "scaleState",
        "wilsonBeta",
        "plaquetteConvention",
        "polymerBounds"
      ],
      "properties": {
        "kind": {
          "const": "EffectiveAction"
        },
        "theory": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "const": "rg-contract/1"
        },
        "scaleState": {
          "$ref": "#/$defs/digest"
        },
        "wilsonBeta": {
          "$ref": "#/$defs/interval"
        },
        "plaquetteConvention": {
          "type": "string",
          "minLength": 1
        },
        "polymerBounds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "polymer",
              "KAbsUpper"
            ],
            "properties": {
              "polymer": {
                "type": "string"
              },
              "KAbsUpper": {
                "$ref": "#/$defs/rational"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "kind",
        "theory",
        "version",
        "algebraId",
        "operator",
        "symbol",
        "symmetries",
        "normalization",
        "mappingCertificate"
      ],
      "properties": {
        "kind": {
          "const": "InvariantObservable"
        },
        "theory": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "const": "rg-contract/1"
        },
        "algebraId": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "enum": [
            "WilsonLoop",
            "SmearedPlaquette"
          ]
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "symmetries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "normalization": {
          "$ref": "#/$defs/rational"
        },
        "mappingCertificate": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "kind",
        "theory",
        "version",
        "module",
        "theorem",
        "sourceSha256",
        "theoremStatementSha256",
        "axioms",
        "imports",
        "dependencies",
        "status",
        "leanVersion",
        "buildLogSha256"
      ],
      "properties": {
        "kind": {
          "const": "LeanProofArtifact"
        },
        "theory": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "const": "rg-contract/1"
        },
        "module": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_./]*\\.lean$"
        },
        "theorem": {
          "type": "string",
          "minLength": 1
        },
        "sourceSha256": {
          "$ref": "#/$defs/digest"
        },
        "theoremStatementSha256": {
          "$ref": "#/$defs/digest"
        },
        "axioms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "imports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "status": {
          "enum": [
            "proved",
            "assumed",
            "failed"
          ]
        },
        "leanVersion": {
          "type": "string"
        },
        "buildLogSha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "kind",
        "theory",
        "version",
        "source",
        "target",
        "sourceAction",
        "targetAction",
        "observable",
        "blockFactor",
        "constantEnvelope",
        "certificates",
        "leanProof",
        "status"
      ],
      "properties": {
        "kind": {
          "const": "RGTransition"
        },
        "theory": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "const": "rg-contract/1"
        },
        "source": {
          "$ref": "#/$defs/digest"
        },
        "target": {
          "$ref": "#/$defs/digest"
        },
        "sourceAction": {
          "$ref": "#/$defs/digest"
        },
        "targetAction": {
          "$ref": "#/$defs/digest"
        },
        "observable": {
          "$ref": "#/$defs/digest"
        },
        "blockFactor": {
          "type": "integer",
          "minimum": 2
        },
        "constantEnvelope": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/constant"
          }
        },
        "certificates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "leanProof": {
          "$ref": "#/$defs/digest"
        },
        "status": {
          "const": "candidate"
        }
      },
      "additionalProperties": false
    }
  ]
}
